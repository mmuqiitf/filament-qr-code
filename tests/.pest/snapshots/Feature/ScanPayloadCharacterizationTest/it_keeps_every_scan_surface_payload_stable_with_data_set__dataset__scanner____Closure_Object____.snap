{
    "beepDurationMs": 80,
    "beepFrequency": 880,
    "burstThresholdMs": 50,
    "fileScanFailedMessage": "No barcode or QR code found in the selected image.",
    "formats": [
        "QR_CODE"
    ],
    "fps": 10,
    "hardwareScanner": true,
    "insecureMessage": "Camera needs a secure context: serve this page over https or open it on localhost, then allow camera access.",
    "minBarcodeLength": 2,
    "minFastKeys": 1,
    "nextField": "employee",
    "preferRearCamera": true,
    "preventSubmit": true,
    "qrbox": 250,
    "scanTimeoutMs": 150,
    "sound": true,
    "suppressWhenGlobalListenerActive": true,
    "terminators": [
        "Enter",
        "Tab"
    ],
    "vibrate": true,
    "vibrateDurationMs": 100
}