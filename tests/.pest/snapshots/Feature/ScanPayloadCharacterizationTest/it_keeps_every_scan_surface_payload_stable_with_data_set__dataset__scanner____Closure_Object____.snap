{
    "beepDurationMs": 80,
    "beepFrequency": 880,
    "burstThresholdMs": 50,
    "clearOnReject": true,
    "continuousDisplay": "empty",
    "cooldownMs": 0,
    "errorFeedback": {
        "sound": true,
        "vibrate": [
            80,
            60,
            80
        ],
        "flash": true
    },
    "fileScanFailedMessage": "No barcode or QR code found in the selected image.",
    "formats": [
        "QR_CODE"
    ],
    "fps": 10,
    "hardwareScanner": true,
    "hardwareScope": "focus",
    "insecureMessage": "Camera needs a secure context: serve this page over https or open it on localhost, then allow camera access.",
    "keepCameraOpen": false,
    "minBarcodeLength": 2,
    "minFastKeys": 1,
    "mode": "single",
    "nextField": "employee",
    "pauseOnReject": false,
    "preferRearCamera": true,
    "preventSubmit": true,
    "qrbox": 250,
    "scanFailedMessage": "The scan could not be checked. Please try again.",
    "scanTimeoutMs": 150,
    "serverCheck": false,
    "sound": true,
    "successFeedback": {
        "sound": true,
        "vibrate": [
            100
        ],
        "flash": true
    },
    "suppressWhenGlobalListenerActive": true,
    "syncOptions": "morph",
    "terminators": [
        "Enter",
        "Tab"
    ],
    "vibrate": true,
    "vibrateDurationMs": 100
}