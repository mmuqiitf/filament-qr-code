{
    "name": "mmuqiitf/filament-qr-code",
    "description": "A powerful, modern QR code package for Filament v5 supporting generation, camera reading, sequential fields, and hardware wedge scanners.",
    "keywords": [
        "mmuqiitf",
        "laravel",
        "filament",
        "filament-plugin",
        "filament-v5",
        "qr-code",
        "barcode-scanner",
        "hardware-scanner",
        "sequential-scan"
    ],
    "homepage": "https://github.com/mmuqiitf/filament-qr-code",
    "license": "MIT",
    "authors": [
        {
            "name": "Muhammad Muqiit Faturrahman",
            "email": "muqiitf@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "bacon/bacon-qr-code": "^3.0",
        "filament/filament": "^5.0",
        "filament/forms": "^5.0",
        "filament/tables": "^5.0",
        "filament/infolists": "^5.0",
        "filament/actions": "^5.0",
        "filament/support": "^5.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-laravel": "^3.0",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Mmuqiitf\\FilamentQrCode\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Mmuqiitf\\FilamentQrCode\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test-style": "vendor/bin/pint --test"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Mmuqiitf\\FilamentQrCode\\FilamentQrCodeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
