{
    "allowDuplicates": true,
    "beepDurationMs": 80,
    "beepFrequency": 880,
    "burstThresholdMs": 50,
    "cameraControls": true,
    "delayBetweenScansMs": 900,
    "fileScanFailedMessage": "No barcode or QR code found in the selected image.",
    "formats": [],
    "fps": 12,
    "hardwareScanner": true,
    "insecureMessage": "Camera needs a secure context: serve this page over https or open it on localhost, then allow camera access.",
    "minBarcodeLength": 2,
    "minFastKeys": 3,
    "preferRearCamera": true,
    "preventSubmit": true,
    "qrbox": 250,
    "scanTimeoutMs": 150,
    "sound": true,
    "terminators": [
        "Enter",
        "Tab"
    ],
    "vibrate": true,
    "vibrateDurationMs": 100,
    "wireScanHandler": false
}