# Path-based git attributes
# https://git-scm.com/docs/gitattributes

# Keep development-only files out of the Composer dist archive.
/.agents                     export-ignore
/.github                     export-ignore
/.serena                     export-ignore
/.gitattributes              export-ignore
/.gitignore                  export-ignore
/.php-version                export-ignore
/AGENTS.md                   export-ignore
/CONTEXT.md                  export-ignore
/CONTRIBUTING.md             export-ignore
/docs/superpowers            export-ignore
/package.json                export-ignore
/package-lock.json           export-ignore
/phpstan.neon.dist           export-ignore
/phpunit.xml.dist            export-ignore
/pint.json                   export-ignore
/skills-lock.json            export-ignore
/tests                       export-ignore
/vite.config.js              export-ignore
/vitest.config.js            export-ignore
/resources/js/*.test.js      export-ignore
/resources/js/alpine-test-harness.js export-ignore
